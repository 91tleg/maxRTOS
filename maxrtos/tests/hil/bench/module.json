{
  "module": {
    "name": "bench_context_switch"
  },
  "memory": {
    "flash": {
      "origin": "0x08000000",
      "size": "2M"
    },
    "dtcm": {
      "origin": "0x20000000",
      "size": "128K"
    },
    "sram": {
      "origin": "0x24000000",
      "size": "512K"
    }
  },
  "stack_region": "sram",
  "limits": {
    "mutexes": 1,
    "semaphores": 1,
    "buffers": 1
  },
  "partitions": [
    {
      "id": 0,
      "name": "yieldp",
      "type": "system",
      "mpu": {
        "access": "read_write",
        "executable": false
      },
      "processes": [
        {
          "name": "yield_a",
          "stack_size": "512B",
          "stack_alignment": "512B",
          "priority": 5
        },
        {
          "name": "yield_b",
          "stack_size": "512B",
          "stack_alignment": "512B",
          "priority": 5
        }
      ]
    },
    {
      "id": 1,
      "name": "queuep",
      "type": "system",
      "mpu": {
        "access": "read_write",
        "executable": false
      },
      "processes": [
        {
          "name": "queue_tx",
          "stack_size": "512B",
          "stack_alignment": "512B",
          "priority": 5
        },
        {
          "name": "queue_rx",
          "stack_size": "512B",
          "stack_alignment": "512B",
          "priority": 5
        }
      ]
    },
    {
      "id": 2,
      "name": "mutexp",
      "type": "system",
      "mpu": {
        "access": "read_write",
        "executable": false
      },
      "processes": [
        {
          "name": "mutex_a",
          "stack_size": "512B",
          "stack_alignment": "512B",
          "priority": 5
        },
        {
          "name": "mutex_b",
          "stack_size": "512B",
          "stack_alignment": "512B",
          "priority": 5
        }
      ]
    }
  ],
  "schedule": {
    "major_frame": [
      {
        "partition": 0,
        "duration_ticks": 5
      },
      {
        "partition": 1,
        "duration_ticks": 3
      },
      {
        "partition": 2,
        "duration_ticks": 3
      }
    ]
  },
  "mpu": {
    "regions": [
      {
        "number": 0,
        "base": "0x08000000",
        "size": "2M",
        "access": "read_only",
        "executable": true
      },
      {
        "number": 1,
        "base": "0x58000000",
        "size": "512K",
        "access": "read_write",
        "executable": false
      },
      {
        "number": 2,
        "base": "0x20000000",
        "size": "128K",
        "access": "priv_read_write",
        "executable": false
      },
      {
        "number": 3,
        "base": "0x24000000",
        "size": "512K",
        "access": "priv_read_write",
        "executable": false
      }
    ],
    "privileged_default_map": true
  },
  "ports": [
    {
      "name": "bench_q",
      "message_size": "4B",
      "capacity": 4,
      "senders": [
        "queuep"
      ],
      "receivers": [
        "queuep"
      ]
    }
  ]
}
